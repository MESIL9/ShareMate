    // ================= 목록 (탭 / 검색 / 카테고리 / 찜) =================
    /** mode: 0=전체검색, 1=대여, 2=물물교환 / tab(대여만): 0=전체, 1=대여제공, 2=대여요청 */
    void list(int mode, String q0, int tab0) {
        int[] kp = keep; keep = null; // 상세/등록에서 돌아올 때 필터 상태 유지
        int[] tab = {tab0};
        JPanel p = new JPanel(new BorderLayout()); p.setBackground(Color.WHITE);
        JPanel head = col();
        head.add(header(mode == 1 ? "대여" : mode == 2 ? "물물교환" : (kp != null && kp[3] == 1 ? "찜 목록" : "검색 결과"), this::home));
        JTextField sf = hintField(mode == 2 ? "교환하고 싶은 물건을 검색해 보세요" : "빌리고 싶은 물건을 검색해 보세요"); sf.setText(q0);
        head.add(searchWrap(sf));

        JComboBox<String> cat = new JComboBox<>(); cat.addItem("카테고리"); for (String c : CATS) cat.addItem(c);
        JComboBox<String> period = new JComboBox<>(new String[]{"기간", "기간 오름차순", "기간 내림차순"});
        JComboBox<String> priceC = new JComboBox<>(new String[]{"가격대", "가격 오름차순", "가격 내림차순"});
        JCheckBox favOnly = new JCheckBox("♥찜만"); favOnly.setOpaque(false);
        if (kp != null) { cat.setSelectedIndex(kp[0]); period.setSelectedIndex(kp[1]); priceC.setSelectedIndex(kp[2]); favOnly.setSelected(kp[3] == 1); }
        cat.setPreferredSize(new Dimension(96, 28)); period.setPreferredSize(new Dimension(92, 28)); priceC.setPreferredSize(new Dimension(92, 28));
        JPanel opt = new JPanel(new FlowLayout(FlowLayout.LEFT, 4, 4)); opt.setOpaque(false); opt.setAlignmentX(0); opt.setMaximumSize(new Dimension(Integer.MAX_VALUE, 40));
        opt.add(cat); if (mode != 2) { opt.add(period); opt.add(priceC); } opt.add(favOnly);
        JLabel count = lbl("", 12, GRAY, false), sortL = lbl("최신순", 12, GRAY, false);
        JPanel cnt = new JPanel(new BorderLayout()); cnt.setOpaque(false); cnt.setBorder(new EmptyBorder(0, 12, 0, 12)); cnt.setAlignmentX(0);
        cnt.setMaximumSize(new Dimension(Integer.MAX_VALUE, 26)); cnt.add(count, BorderLayout.WEST); cnt.add(sortL, BorderLayout.EAST);

        Runnable again = () -> {
            keep = new int[]{cat.getSelectedIndex(), period.getSelectedIndex(), priceC.getSelectedIndex(), favOnly.isSelected() ? 1 : 0};
            list(mode, sf.getText(), tab[0]);
        };
        JPanel lp = col();
        Runnable refresh = () -> {
            lp.removeAll();
            Set<Long> favs = st.favs(me); String q = sf.getText().trim().toLowerCase();
            List<Item> all = st.items(); Collections.reverse(all); List<Item> res = new ArrayList<>(); // 기본 최신순
            for (Item it : all) {
                if (mode == 1 && it.kind.equals(EX) || mode == 2 && !it.kind.equals(EX)) continue;
                if (mode == 1 && tab[0] == 1 && !it.kind.equals(OFFER)) continue;
                if (mode == 1 && tab[0] == 2 && !it.kind.equals(REQ)) continue;
                if (cat.getSelectedIndex() > 0 && !it.category.equals(cat.getSelectedItem())) continue;
                if (favOnly.isSelected() && !favs.contains(it.id)) continue;
                if (!q.isEmpty() && !(it.title + it.tags + it.desc + it.want + it.category).toLowerCase().contains(q)) continue;
                res.add(it);
            }
            int ps = period.getSelectedIndex(), pc = priceC.getSelectedIndex(); String sortName = "최신순";
            if (mode != 2 && (ps > 0 || pc > 0)) { // 기간 / 대여비 기준 정렬 (물물교환 상품은 항상 맨 뒤)
                boolean byP = ps > 0, asc = (byP ? ps : pc) == 1;
                res.sort((x, y) -> {
                    boolean ex = x.kind.equals(EX), ey = y.kind.equals(EX);
                    if (ex || ey) return ex == ey ? 0 : ex ? 1 : -1;
                    int c = byP ? Integer.compare(x.months, y.months) : Integer.compare(x.price, y.price);
                    return asc ? c : -c;
                });
                sortName = (byP ? "기간 " : "가격 ") + (asc ? "오름차순" : "내림차순");
            }
            for (Item it : res) { lp.add(card(it, favs, () -> detail(it, again, true))); lp.add(Box.createVerticalStrut(8)); }
            if (res.isEmpty()) lp.add(lbl("<html>등록된 상품이 없어요.<br>아래 '＋ 상품 등록'으로 첫 상품을 올려보세요!</html>", 12, GRAY, false));
            count.setText("전체 " + res.size()); sortL.setText(sortName); lp.revalidate(); lp.repaint();
        };

        if (mode == 1) { // 전체 / 대여제공 / 대여요청 탭
            JPanel tabs = new JPanel(new GridLayout(1, 3)); tabs.setBackground(Color.WHITE); tabs.setAlignmentX(0); tabs.setMaximumSize(new Dimension(Integer.MAX_VALUE, 40));
            String[] tn = {"전체", "대여제공", "대여요청"}; JButton[] tb = new JButton[3];
            Runnable style = () -> { for (int i = 0; i < 3; i++) {
                tb[i].setForeground(i == tab[0] ? BLUE : GRAY); tb[i].setFont(tb[i].getFont().deriveFont(i == tab[0] ? Font.BOLD : Font.PLAIN));
                tb[i].setBorder(BorderFactory.createCompoundBorder(new MatteBorder(0, 0, 2, 0, i == tab[0] ? BLUE : Color.WHITE), new EmptyBorder(8, 0, 8, 0))); } };
            for (int i = 0; i < 3; i++) { final int k = i; tb[i] = flat(tn[i], () -> { tab[0] = k; style.run(); refresh.run(); }); tabs.add(tb[i]); }
            style.run(); head.add(tabs);
        }
        head.add(opt); head.add(cnt); p.add(head, BorderLayout.NORTH);

        boolean[] busy = {false}; // 기간 정렬과 가격 정렬은 동시에 선택되지 않음
        sf.addActionListener(e -> refresh.run()); cat.addActionListener(e -> refresh.run()); favOnly.addActionListener(e -> refresh.run());
        period.addActionListener(e -> { if (!busy[0] && period.getSelectedIndex() > 0) { busy[0] = true; priceC.setSelectedIndex(0); busy[0] = false; } refresh.run(); });
        priceC.addActionListener(e -> { if (!busy[0] && priceC.getSelectedIndex() > 0) { busy[0] = true; period.setSelectedIndex(0); busy[0] = false; } refresh.run(); });
        refresh.run();
        p.add(scroll(lp), BorderLayout.CENTER);

        JPanel fab = new JPanel(); fab.setBackground(Color.WHITE); fab.setBorder(new EmptyBorder(8, 0, 8, 0));
        fab.add(btn("＋ 상품 등록", () -> register(mode == 2 ? EX : tab[0] == 2 ? REQ : OFFER, again), 140, 42));
        p.add(fab, BorderLayout.SOUTH);
        set(p, true);
        poll(() -> st.items().size(), refresh); // 다른 사용자가 올린 상품 자동 반영
    }

