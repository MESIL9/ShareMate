    // ================= 채팅 (실제 사용자 간, 1초 폴링) =================
    void chat(Item it, String buyer, Runnable back) {
        String other = me.equals(buyer) ? it.owner : buyer;
        JPanel p = new JPanel(new BorderLayout()); p.setBackground(Color.WHITE);
        JPanel head = col(); head.add(header(nick(other), back));
        JPanel sum = new JPanel(new BorderLayout(10, 0)); sum.setBackground(it.bg()); sum.setBorder(new EmptyBorder(8, 12, 8, 12));
        sum.add(thumb(it, 48, 48), BorderLayout.WEST);
        JPanel si = new JPanel(new GridLayout(2, 1)); si.setOpaque(false); si.add(lbl(it.title, 13, Color.BLACK, true)); si.add(lbl(priceText(it), 12, GRAY, false));
        sum.add(si); sum.setAlignmentX(0); sum.setMaximumSize(new Dimension(Integer.MAX_VALUE, 66)); head.add(sum);
        p.add(head, BorderLayout.NORTH);

        JPanel mp = col(); mp.setBorder(new EmptyBorder(8, 10, 8, 10));
        JScrollPane sp = scroll(mp); p.add(sp, BorderLayout.CENTER); long[] lastIn = {0};
        Runnable render = () -> {
            mp.removeAll(); String lastDay = ""; long maxIn = 0;
            for (Msg m : st.chats()) {
                if (m.item != it.id || !m.buyer.equals(buyer)) continue;
                if (!m.sender.equals(me)) maxIn = Math.max(maxIn, m.ts);
                String day = fmt(m.ts, "M월 d일 EEEE");
                if (!day.equals(lastDay)) { JLabel d = new JLabel(day, SwingConstants.CENTER); d.setForeground(GRAY); d.setFont(d.getFont().deriveFont(11f)); d.setAlignmentX(0); d.setMaximumSize(new Dimension(Integer.MAX_VALUE, 26)); mp.add(d); lastDay = day; }
                mp.add(bubbleRow(m));
            }
            mp.revalidate(); mp.repaint();
            if (maxIn > lastIn[0]) { lastIn[0] = maxIn; st.markRead(me, it.id + "|" + buyer); } // 이 방의 알림은 읽음 처리
            SwingUtilities.invokeLater(() -> { JScrollBar b = sp.getVerticalScrollBar(); b.setValue(b.getMaximum()); });
        };
        render.run();

        JTextField in = new JTextField(); in.setBorder(BorderFactory.createCompoundBorder(BorderFactory.createLineBorder(LINE), new EmptyBorder(8, 10, 8, 10)));
        Runnable send = () -> {
            String t = in.getText().trim(); if (t.isEmpty()) return;
            st.send(it.id, buyer, me, t); in.setText(""); render.run();
        };
        in.addActionListener(e -> send.run());
        JPanel bar = new JPanel(new BorderLayout(8, 0)); bar.setBorder(new EmptyBorder(8, 10, 8, 10)); bar.setBackground(Color.WHITE);
        bar.add(in); bar.add(btn("전송", send, 64, 38), BorderLayout.EAST); p.add(bar, BorderLayout.SOUTH);
        set(p, false);
        currentRoom = it.id + "|" + buyer;
        poll(() -> st.chats().size(), render); // 상대 메시지 자동 수신
        in.requestFocusInWindow();
    }

    JComponent bubbleRow(Msg m) {
        boolean mine = m.sender.equals(me);
        JPanel r = new JPanel(new FlowLayout(mine ? FlowLayout.RIGHT : FlowLayout.LEFT, 4, 4)); r.setOpaque(false);
        JLabel tm = lbl(fmt(m.ts, "a h:mm"), 10, GRAY, false); JComponent b = new Bubble(m.text, mine);
        if (mine) { r.add(tm); r.add(b); } else { r.add(b); r.add(tm); }
        r.setMaximumSize(new Dimension(Integer.MAX_VALUE, r.getPreferredSize().height + 6)); r.setAlignmentX(0); return r;
    }

    static class Bubble extends JPanel {
        final Color c;
        Bubble(String t, boolean mine) {
            c = mine ? new Color(0xDCEBFF) : LIGHT; setOpaque(false); setLayout(new BorderLayout()); setBorder(new EmptyBorder(8, 12, 8, 12));
            JLabel l = new JLabel(); int w = Math.min(190, l.getFontMetrics(l.getFont()).stringWidth(t) + 8);
            l.setText("<html><body style='width:" + w + "px'>" + esc(t) + "</body></html>"); add(l);
        }
        @Override protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create(); g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(c); g2.fillRoundRect(0, 0, getWidth(), getHeight(), 18, 18); g2.dispose(); super.paintComponent(g);
        }
    }

    // ================= 알림 (채팅이 오면 종 모양에 숫자 + 팝업) =================
    Map<Long, Item> itemMap() { Map<Long, Item> m = new HashMap<>(); for (Item i : st.items()) m.put(i.id, i); return m; }

    /** 내가 참여한 채팅방에서 상대가 보낸 메시지 */
    List<Msg> incoming(List<Msg> all, Map<Long, Item> im) {
        List<Msg> r = new ArrayList<>();
        for (Msg m : all) { if (m.sender.equals(me)) continue; Item it = im.get(m.item); if (it != null && (m.buyer.equals(me) || it.owner.equals(me))) r.add(m); }
        return r;
    }
    int unread() {
        Map<String, Long> rd = st.reads(me); int n = 0;
        for (Msg m : incoming(st.chats(), itemMap())) if (m.ts > rd.getOrDefault(m.item + "|" + m.buyer, 0L)) n++;
        return n;
    }
    JButton bell(Runnable back) {
        JButton b = flat("🔔", () -> notifications(back)); b.setFont(b.getFont().deriveFont(18f)); bells.add(b); updateBells(unread()); return b;
    }
    void updateBells(int n) { for (JButton b : bells) { b.setText(n > 0 ? "🔔 " + n : "🔔"); b.setForeground(n > 0 ? Color.RED : Color.BLACK); } }

    JPanel homeBar() {
        JPanel hb = new JPanel(new FlowLayout(FlowLayout.RIGHT, 4, 0)); hb.setOpaque(false); hb.setAlignmentX(0); hb.setMaximumSize(new Dimension(Integer.MAX_VALUE, 40));
