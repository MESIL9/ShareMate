        d.setLocationRelativeTo(this);
        JPanel form = new JPanel();
        form.setBackground(Color.WHITE);
        form.setBorder(new EmptyBorder(18, 22, 18, 22));
        form.setLayout(new BoxLayout(form, BoxLayout.Y_AXIS));

        JLabel imagePreview = label("사진을 선택해 주세요", 12, false, MUTED);
        imagePreview.setHorizontalAlignment(SwingConstants.CENTER);
        imagePreview.setPreferredSize(new Dimension(130, 105));
        imagePreview.setMaximumSize(new Dimension(330, 105));
        imagePreview.setOpaque(true);
        imagePreview.setBackground(PALE);
        imagePreview.setBorder(new LineBorder(new Color(225, 228, 235), 1, true));
        final String[] imagePath = {""};
        JButton chooseImage = button("사진 선택", PALE, TEXT);
        chooseImage.addActionListener(e -> {
            JFileChooser chooser = new JFileChooser();
            chooser.setDialogTitle("상품 사진 선택");
            int result = chooser.showOpenDialog(d);
            if (result == JFileChooser.APPROVE_OPTION) {
                File file = chooser.getSelectedFile();
                imagePath[0] = file.getAbsolutePath();
                ImageIcon icon = new ImageIcon(imagePath[0]);
                Image scaled = icon.getImage().getScaledInstance(120, 95, Image.SCALE_SMOOTH);
                imagePreview.setIcon(new ImageIcon(scaled));
                imagePreview.setText("");
            }
        });
        form.add(imagePreview);
        form.add(Box.createVerticalStrut(7));
        form.add(chooseImage);
        form.add(Box.createVerticalStrut(14));

        JTextField name = addField(form, "상품명", "예: 전공 서적, 전기포트");
        JComboBox<String> type = addCombo(form, "거래 유형", new String[]{"대여", "물물교환"});
        JComboBox<String> category = addCombo(form, "카테고리", new String[]{"도서", "생활용품", "학업/실습", "문구", "의류", "기타"});
        JComboBox<String> condition = addCombo(form, "상품 상태", new String[]{"새 상품", "매우 좋음", "좋음", "사용감 있음"});
        JTextField price = addField(form, "대여료 (원)", "대여 상품이 아니면 0");
        JTextField deposit = addField(form, "보증금 (원)", "대여 상품이 아니면 0");
        form.add(label("상품 설명", 12, true, TEXT));
        form.add(Box.createVerticalStrut(5));
        JTextArea description = new JTextArea(4, 20);
        description.setFont(new Font("맑은 고딕", Font.PLAIN, 13));
        description.setLineWrap(true);
        description.setWrapStyleWord(true);
        description.setBorder(new CompoundBorder(new LineBorder(new Color(220, 224, 232), 1, true), new EmptyBorder(8, 9, 8, 9)));
        form.add(new JScrollPane(description));
        form.add(Box.createVerticalStrut(15));
        JButton submit = button("등록하기", BLUE, Color.WHITE);
        submit.addActionListener(e -> {
            String productName = name.getText().trim();
            if (productName.isEmpty()) {
                JOptionPane.showMessageDialog(d, "상품명을 입력해 주세요.");
                return;
            }
            int p = parseMoney(price.getText());
            int dep = parseMoney(deposit.getText());
            if (p < 0 || dep < 0) {
                JOptionPane.showMessageDialog(d, "가격과 보증금은 숫자로 입력해 주세요.");
                return;
            }
            String selectedType = (String) type.getSelectedItem();
            if (!"대여".equals(selectedType)) { p = 0; dep = 0; }
            Product product = new Product(productName, (String) category.getSelectedItem(),
                    selectedType, description.getText().trim(), (String) condition.getSelectedItem(),
                    p, dep, imagePath[0]);
            products.add(0, product);
            saveData();
            d.dispose();
            currentCategory = "전체";
            searchField.setText("");
            showPage("market");
            JOptionPane.showMessageDialog(this, "상품이 등록되었습니다!");
        });
        form.add(submit);

        JScrollPane scroll = new JScrollPane(form);
        scroll.setBorder(null);
        scroll.getVerticalScrollBar().setUnitIncrement(15);
        d.setContentPane(scroll);
        d.setVisible(true);
    }

    private JTextField addField(JPanel parent, String title, String hint) {
        parent.add(label(title, 12, true, TEXT));
        parent.add(Box.createVerticalStrut(5));
        JTextField field = new JTextField();
        field.setFont(new Font("맑은 고딕", Font.PLAIN, 13));
        field.setToolTipText(hint);
        field.setBorder(new CompoundBorder(new LineBorder(new Color(220, 224, 232), 1, true), new EmptyBorder(9, 10, 9, 10)));
        parent.add(field);
        parent.add(Box.createVerticalStrut(10));
        return field;
    }

    private JComboBox<String> addCombo(JPanel parent, String title, String[] values) {
        parent.add(label(title, 12, true, TEXT));
        parent.add(Box.createVerticalStrut(5));
        JComboBox<String> combo = new JComboBox<String>(values);
        combo.setFont(new Font("맑은 고딕", Font.PLAIN, 13));
        combo.setBackground(Color.WHITE);
        parent.add(combo);
        parent.add(Box.createVerticalStrut(10));
        return combo;
    }

    private int parseMoney(String value) {
        if (value == null || value.trim().isEmpty()) return 0;
        try { return Integer.parseInt(value.replace(",", "").trim()); }
        catch (NumberFormatException e) { return -1; }
    }

    // -------------------- 채팅 --------------------

    private void openChatDialog(Product p) {
        final JDialog d = new JDialog(this, p.name + " 채팅", false);
        d.setSize(380, 570);
        d.setLocationRelativeTo(this);
        JPanel main = new JPanel(new BorderLayout());
        main.setBackground(PALE);
        JPanel top = new JPanel(new BorderLayout());
        top.setBackground(Color.WHITE);
        top.setBorder(new EmptyBorder(13, 16, 13, 16));
        top.add(label("‹   " + p.owner, 16, true, NAVY), BorderLayout.CENTER);
        top.add(label("상품 문의", 11, false, MUTED), BorderLayout.EAST);
        main.add(top, BorderLayout.NORTH);

        JPanel messages = new JPanel();
        messages.setBackground(PALE);
        messages.setBorder(new EmptyBorder(14, 12, 14, 12));
        messages.setLayout(new BoxLayout(messages, BoxLayout.Y_AXIS));
        Runnable renderMessages = () -> {
            messages.removeAll();
            if (p.messages.isEmpty()) {
                messages.add(Box.createVerticalStrut(25));
                JLabel welcome = label("상품에 대해 궁금한 점을 물어보세요!", 12, false, MUTED);
                welcome.setAlignmentX(Component.CENTER_ALIGNMENT);
                messages.add(welcome);
            } else {
                for (String msg : p.messages) {
                    JPanel bubble = new JPanel(new FlowLayout(FlowLayout.RIGHT, 0, 3));
                    bubble.setOpaque(false);
                    JLabel text = label(msg, 13, false, TEXT);
                    text.setOpaque(true);
                    text.setBackground(new Color(222, 232, 255));
                    text.setBorder(new EmptyBorder(9, 12, 9, 12));
                    bubble.add(text);
                    bubble.setAlignmentX(Component.RIGHT_ALIGNMENT);
                    messages.add(bubble);
                }
            }
            messages.revalidate();
            messages.repaint();
        };
        renderMessages.run();
        JScrollPane scroll = new JScrollPane(messages);
        scroll.setBorder(null);
        main.add(scroll, BorderLayout.CENTER);

        JPanel sendPanel = new JPanel(new BorderLayout(8, 0));
        sendPanel.setBackground(Color.WHITE);
        sendPanel.setBorder(new EmptyBorder(10, 12, 10, 12));
        JTextField input = new JTextField();
        input.setFont(new Font("맑은 고딕", Font.PLAIN, 13));
        input.setBorder(new CompoundBorder(new LineBorder(new Color(225, 228, 235), 1, true), new EmptyBorder(9, 10, 9, 10)));
        JButton send = button("전송", BLUE, Color.WHITE);
        ActionListener sendAction = e -> {
            String msg = input.getText().trim();
            if (!msg.isEmpty()) {
                p.messages.add(msg);
                saveData();
                input.setText("");
                renderMessages.run();
                SwingUtilities.invokeLater(() -> scroll.getVerticalScrollBar().setValue(scroll.getVerticalScrollBar().getMaximum()));
            }
        };
        send.addActionListener(sendAction);
        input.addActionListener(sendAction);
        sendPanel.add(input, BorderLayout.CENTER);
        sendPanel.add(send, BorderLayout.EAST);
        main.add(sendPanel, BorderLayout.SOUTH);
        d.setContentPane(main);
        d.setVisible(true);
    }

