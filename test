        p.add(Box.createVerticalStrut(16));
        Runnable doLogin = () -> {
            String n = st.login(id.getText().trim(), new String(pw.getPassword()));
            if (n == null) { warn("아이디 또는 비밀번호가 올바르지 않아요."); return; }
            me = id.getText().trim(); meNick = n; nicks.put(me, n); lastNotified = System.currentTimeMillis(); home();
        };
        Runnable doSignup = () -> {
            String i = id.getText().trim(), w = new String(pw.getPassword()), n = nick.getText().trim();
            if (!i.matches("[A-Za-z0-9_]{3,16}")) { warn("아이디는 영문/숫자/_ 3~16자로 입력해 주세요."); return; }
            if (w.length() < 4) { warn("비밀번호는 4자 이상이어야 해요."); return; }
            if (n.isEmpty()) { warn("닉네임을 입력해 주세요."); return; }
            String err = st.signup(i, w, n);
            if (err != null) { warn(err); return; }
            me = i; meNick = n; nicks.put(i, n); lastNotified = System.currentTimeMillis(); JOptionPane.showMessageDialog(this, "가입이 완료되었어요!"); home();
        };
        pw.addActionListener(e -> doLogin.run());
        JPanel bs = new JPanel(new GridLayout(1, 2, 8, 0)); bs.setOpaque(false); bs.setAlignmentX(0); bs.setMaximumSize(new Dimension(Integer.MAX_VALUE, 46));
        bs.add(btn("로그인", doLogin, 0, 44)); bs.add(btn("회원가입", doSignup, 0, 44));
        p.add(bs);
        set(top(p), false);
    }

