    private void showPage(String page) {
        currentPage = page;
        root.removeAll();
        if ("home".equals(page)) {
            root.add(createHomePage(), "home");
        } else if ("market".equals(page)) {
            root.add(createMarketPage(), "market");
        } else {
            root.add(createMyPage(), "mypage");
        }
        cardLayout.show(root, page);
        root.revalidate();
        root.repaint();
    }

