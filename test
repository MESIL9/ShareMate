    static JPanel col() { JPanel p = new JPanel(); p.setLayout(new BoxLayout(p, BoxLayout.Y_AXIS)); p.setBackground(Color.WHITE); return p; }
    static JPanel top(JComponent c) { JPanel w = new JPanel(new BorderLayout()); w.setBackground(Color.WHITE); w.add(c, BorderLayout.NORTH); return w; }
    static JScrollPane wrapScroll(JComponent c) { JScrollPane s = new JScrollPane(top(c)); s.setBorder(null); return s; }

    static JLabel lbl(String t, int size, Color c, boolean bold) {
        JLabel l = new JLabel(t); l.setFont(l.getFont().deriveFont(bold ? Font.BOLD : Font.PLAIN, (float) size));
        l.setForeground(c); l.setAlignmentX(0); l.setBorder(new EmptyBorder(2, 0, 2, 0)); return l;
    }

    static JButton flat(String t, Runnable r) {
        JButton b = new JButton(t); b.setBorderPainted(false); b.setContentAreaFilled(false); b.setFocusPainted(false);
        b.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR)); if (r != null) b.addActionListener(e -> r.run()); return b;
    }

    /** 둥근 파란 버튼. w==0 이면 가로 전체 */
    static JButton btn(String t, Runnable r, int w, int h) {
        JButton b = new JButton(t) {
            @Override protected void paintComponent(Graphics g) {
                Graphics2D g2 = (Graphics2D) g.create(); g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                g2.setColor(getModel().isPressed() ? BLUE.darker() : BLUE); g2.fillRoundRect(0, 0, getWidth(), getHeight(), 22, 22); g2.dispose();
                super.paintComponent(g);
            }
        };
        b.setForeground(Color.WHITE); b.setFont(b.getFont().deriveFont(Font.BOLD)); b.setContentAreaFilled(false);
        b.setBorderPainted(false); b.setFocusPainted(false); b.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        b.setPreferredSize(new Dimension(w == 0 ? 100 : w, h)); if (r != null) b.addActionListener(e -> r.run()); return b;
    }

