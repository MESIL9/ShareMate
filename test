        products.add(new Product("미니 전기포트", "생활용품", "대여", "기숙사에서 사용하기 좋은 소형 전기포트입니다.", "매우 좋음", 2000, 5000, ""));
        products.add(new Product("실습용 공학 계산기", "학업/실습", "물물교환", "계산기 교환 희망합니다. 원하시는 물품을 채팅으로 알려주세요.", "좋음", 0, 0, ""));
        products.add(new Product("미개봉 파일夹 세트", "문구", "물물교환", "사용하지 않은 파일夹 세트입니다. 다른 문구류와 교환해요.", "새 상품", 0, 0, ""));
        saveData();
    }

    @SuppressWarnings("unchecked")
    private void loadData() {
        if (!DATA_FILE.exists()) return;
        try (ObjectInputStream in = new ObjectInputStream(new FileInputStream(DATA_FILE))) {
            Object obj = in.readObject();
            if (obj instanceof ArrayList) products.addAll((ArrayList<Product>) obj);
        } catch (Exception e) {
            System.err.println("저장 데이터를 불러오지 못했습니다: " + e.getMessage());
        }
    }

    private void saveData() {
        try (ObjectOutputStream out = new ObjectOutputStream(new FileOutputStream(DATA_FILE))) {
            out.writeObject(new ArrayList<Product>(products));
        } catch (IOException e) {
            JOptionPane.showMessageDialog(this, "데이터 저장에 실패했습니다.\n" + e.getMessage());
        }
    }

