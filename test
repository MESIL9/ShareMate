    private JPanel statCard(String title, String value) {
        JPanel p = new JPanel();
        p.setBackground(Color.WHITE);
        p.setBorder(new EmptyBorder(15, 12, 15, 12));
        p.setLayout(new BoxLayout(p, BoxLayout.Y_AXIS));
        p.add(label(title, 12, false, MUTED));
        p.add(Box.createVerticalStrut(7));
        p.add(label(value, 20, true, BLUE));
        return p;
    }

    private JButton menuButton(String text) {
        JButton b = new JButton(text + "     ›");
        b.setHorizontalAlignment(SwingConstants.LEFT);
        b.setFont(new Font("맑은 고딕", Font.PLAIN, 14));
        b.setBackground(Color.WHITE);
        b.setForeground(TEXT);
        b.setBorder(new EmptyBorder(15, 14, 15, 14));
        b.setFocusPainted(false);
        return b;
    }

    private void showFavorites() {
        List<Product> favs = new ArrayList<Product>();
        for (Product p : products) if (p.favorite) favs.add(p);
        showProductSelection("찜한 상품", favs);
    }

    private void showChatProducts() {
        List<Product> chats = new ArrayList<Product>();
        for (Product p : products) if (!p.messages.isEmpty()) chats.add(p);
        showProductSelection("채팅 내역", chats);
    }

    private void showProductSelection(String title, List<Product> list) {
        JDialog d = new JDialog(this, title, true);
        d.setSize(370, 500);
        d.setLocationRelativeTo(this);
        JPanel panel = new JPanel();
        panel.setBackground(PALE);
        panel.setBorder(new EmptyBorder(15, 15, 15, 15));
        panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
        panel.add(label(title, 19, true, NAVY));
        panel.add(Box.createVerticalStrut(12));
        if (list.isEmpty()) panel.add(label("아직 표시할 항목이 없습니다.", 13, false, MUTED));
        for (Product p : list) {
            JButton b = menuButton(p.name);
            b.addActionListener(e -> { d.dispose(); if (title.equals("채팅 내역")) openChatDialog(p); else openDetailDialog(p); });
            panel.add(b);
            panel.add(Box.createVerticalStrut(7));
        }
        d.setContentPane(new JScrollPane(panel));
        d.setVisible(true);
    }

    private String money(int amount) {
        return new DecimalFormat("#,###").format(amount) + "원";
    }

