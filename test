    void poll(Supplier<Object> sig, Runnable r) {
        stopPoll(); final Object[] last = {sig.get()};
        pollTimer = new Timer(1000, ev -> { Object s = sig.get(); if (!Objects.equals(s, last[0])) { last[0] = s; r.run(); } });
        pollTimer.start();
    }
    void stopPoll() { if (pollTimer != null) pollTimer.stop(); }

