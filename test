    // ================= 파일 저장소 (append-only) =================
    static class Store {
        final Path dir, img;
        Store(Path d) throws IOException { dir = d; img = d.resolve("images"); Files.createDirectories(img); }

        static String e(String s) {
            StringBuilder b = new StringBuilder();
            for (char c : s.toCharArray()) { if (c == '\\') b.append("\\\\"); else if (c == '\t') b.append("\\t"); else if (c == '\n') b.append("\\n"); else if (c != '\r') b.append(c); }
            return b.toString();
        }
        static String u(String s) {
            StringBuilder b = new StringBuilder();
            for (int i = 0; i < s.length(); i++) {
                char c = s.charAt(i);
                if (c == '\\' && i + 1 < s.length()) { char n = s.charAt(++i); b.append(n == 't' ? '\t' : n == 'n' ? '\n' : n); } else b.append(c);
            }
            return b.toString();
        }
        synchronized void append(String file, String... f) {
            StringBuilder b = new StringBuilder();
            for (int i = 0; i < f.length; i++) { if (i > 0) b.append('\t'); b.append(e(f[i])); }
            b.append('\n');
            try { Files.write(dir.resolve(file), b.toString().getBytes(StandardCharsets.UTF_8), StandardOpenOption.CREATE, StandardOpenOption.APPEND); }
            catch (IOException x) { x.printStackTrace(); }
        }
        List<String[]> read(String file) {
            List<String[]> r = new ArrayList<>(); Path p = dir.resolve(file);
            if (!Files.exists(p)) return r;
            try {
                for (String l : Files.readAllLines(p, StandardCharsets.UTF_8)) {
                    if (l.isEmpty()) continue;
                    String[] a = l.split("\t", -1); for (int i = 0; i < a.length; i++) a[i] = u(a[i]); r.add(a);
                }
            } catch (IOException x) { /* 쓰는 중이면 다음 주기에 다시 읽음 */ }
            return r;
        }

        // ---- 사용자 ----
        static String hash(String id, String pw) {
            try {
                byte[] d = MessageDigest.getInstance("SHA-256").digest((id + ":" + pw).getBytes(StandardCharsets.UTF_8));
                StringBuilder sb = new StringBuilder(); for (byte x : d) sb.append(String.format("%02x", x)); return sb.toString();
            } catch (Exception ex) { throw new RuntimeException(ex); }
        }
        Map<String, String> nicks() { Map<String, String> m = new HashMap<>(); for (String[] a : read("users.tsv")) if (a.length >= 3) m.put(a[0], a[2]); return m; }
        String login(String id, String pw) {
            for (String[] a : read("users.tsv")) if (a.length >= 3 && a[0].equals(id) && a[1].equals(hash(id, pw))) return a[2];
            return null;
        }
        synchronized String signup(String id, String pw, String nick) {
            if (nicks().containsKey(id)) return "이미 사용 중인 아이디예요.";
            append("users.tsv", id, hash(id, pw), nick); return null;
        }

        // ---- 상품 ----
        List<Item> items() {
            List<Item> l = new ArrayList<>();
            for (String[] a : read("items.tsv")) {
                if (a.length < 13) continue;
                try {
                    Item i = new Item(); i.id = Long.parseLong(a[0]); i.owner = a[1]; i.kind = a[2]; i.title = a[3]; i.category = a[4];
                    i.price = Integer.parseInt(a[5]); i.deposit = Integer.parseInt(a[6]); i.want = a[7]; i.tags = a[8]; i.desc = a[9]; i.dong = a[10]; i.imgs = a[11]; i.months = a.length > 13 ? Integer.parseInt(a[13]) : 0;
                    l.add(i);
                } catch (NumberFormatException x) { }
            }
            return l;
        }

        // ---- 찜 (사용자별 마지막 상태가 유효) ----
        Set<Long> favs(String user) {
            Map<Long, Boolean> m = new HashMap<>();
            for (String[] a : read("favs.tsv")) if (a.length >= 3 && a[0].equals(user)) m.put(Long.parseLong(a[1]), a[2].equals("1"));
            Set<Long> s = new HashSet<>(); for (Map.Entry<Long, Boolean> en : m.entrySet()) if (en.getValue()) s.add(en.getKey()); return s;
        }
        void setFav(String user, long item, boolean on) { append("favs.tsv", user, "" + item, on ? "1" : "0"); }
        int favCount(long item) {
            Map<String, Boolean> m = new HashMap<>();
            for (String[] a : read("favs.tsv")) if (a.length >= 3 && a[1].equals("" + item)) m.put(a[0], a[2].equals("1"));
            int n = 0; for (boolean b : m.values()) if (b) n++; return n;
        }

        // ---- 조회수 ----
        void addView(long item) { append("views.tsv", "" + item); }
        int views(long item) { int n = 0; for (String[] a : read("views.tsv")) if (a[0].equals("" + item)) n++; return n; }

        // ---- 읽음 표시 (사용자/채팅방별 마지막으로 읽은 시각) ----
        Map<String, Long> reads(String user) {
            Map<String, Long> m = new HashMap<>();
            for (String[] a : read("noti.tsv")) if (a.length >= 3 && a[0].equals(user)) { try { m.merge(a[1], Long.parseLong(a[2]), Long::max); } catch (NumberFormatException x) { } }
            return m;
        }
        void markRead(String user, String room) { append("noti.tsv", user, room, "" + System.currentTimeMillis()); }

        // ---- 채팅 ----
        List<Msg> chats() {
            List<Msg> l = new ArrayList<>();
            for (String[] a : read("chats.tsv")) {
                if (a.length < 5) continue;
                try { Msg m = new Msg(); m.item = Long.parseLong(a[0]); m.buyer = a[1]; m.sender = a[2]; m.ts = Long.parseLong(a[3]); m.text = a[4]; l.add(m); }
                catch (NumberFormatException x) { }
            }
            return l;
        }
        void send(long item, String buyer, String sender, String text) { append("chats.tsv", "" + item, buyer, sender, "" + System.currentTimeMillis(), text); }
    }

