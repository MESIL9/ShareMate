        c.add(thumb(it, 88, 88), BorderLayout.WEST);
        JPanel info = new JPanel(); info.setOpaque(false); info.setLayout(new BoxLayout(info, BoxLayout.Y_AXIS));
        String price = it.rent ? money(it.price) : "교환 희망 " + it.want;
        info.add(lbl(price, 15, BLUE, true)); info.add(lbl(it.title, 13, Color.BLACK, false));
        info.add(lbl(it.rent ? "보증금 " + money(it.deposit) : it.tags, 11, GRAY, false));
