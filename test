    // ---------- 화면: 상품 등록 ----------
    void register(int initMode, Runnable back) {
        JPanel p = new JPanel(new BorderLayout()); p.setBackground(Color.WHITE);
        p.add(header("상품 등록", back, null), BorderLayout.NORTH);
        JPanel f = col(); f.setBorder(new EmptyBorder(8, 18, 8, 18));

        List<File> photos = new ArrayList<>();
        JLabel photoInfo = lbl("사진 0 / 10", 12, GRAY, false);
        JButton pb = btn("📷 사진 선택", null, 120, 36);
        pb.addActionListener(e -> {
            JFileChooser fc = new JFileChooser(); fc.setMultiSelectionEnabled(true);
            fc.setFileFilter(new javax.swing.filechooser.FileNameExtensionFilter("이미지", "jpg", "jpeg", "png", "gif"));
            if (fc.showOpenDialog(this) == JFileChooser.APPROVE_OPTION) {
                for (File x : fc.getSelectedFiles()) if (photos.size() < 10) photos.add(x);
                photoInfo.setText("사진 " + photos.size() + " / 10 (대표: " + photos.get(0).getName() + ")");
            }
        });
        JPanel pr = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 0)); pr.setOpaque(false); pr.add(pb); pr.add(photoInfo);
        f.add(field("상품 사진", pr));

        JTextField title = new JTextField();
        f.add(field("상품 이름", title));
        JComboBox<String> cat = new JComboBox<>(CATS); f.add(field("카테고리", cat));

        JToggleButton rb = new JToggleButton("대여"), eb = new JToggleButton("교환");
        ButtonGroup bg = new ButtonGroup(); bg.add(rb); bg.add(eb);
        JPanel tg = new JPanel(new GridLayout(1, 2, 6, 0)); tg.setOpaque(false); tg.add(rb); tg.add(eb);
        f.add(field("거래 방식", tg));

        JTextField dep = new JTextField(), fee = new JTextField(), want = new JTextField(), tags = new JTextField();
        CardLayout cl = new CardLayout(); JPanel dyn = new JPanel(cl); dyn.setOpaque(false);
        JPanel rp = col(); rp.add(field("보증금 (원)", dep)); rp.add(field("대여비 (원)", fee));
        JPanel ep = col(); ep.add(field("희망 물품", want)); ep.add(field("해시태그", tags));
        dyn.add(top(rp), "rent"); dyn.add(top(ep), "ex"); dyn.setAlignmentX(0); dyn.setMaximumSize(new Dimension(Integer.MAX_VALUE, 130));
        rb.addActionListener(e -> cl.show(dyn, "rent")); eb.addActionListener(e -> cl.show(dyn, "ex"));
        if (initMode == 2) { eb.setSelected(true); cl.show(dyn, "ex"); } else { rb.setSelected(true); cl.show(dyn, "rent"); }
        f.add(dyn);

        JTextArea desc = new JTextArea(5, 20); desc.setLineWrap(true); desc.setWrapStyleWord(true);
        f.add(field("상품 설명", new JScrollPane(desc)));
        f.add(lbl("거래 동네   대전광역시 유성구 온천2동", 12, GRAY, false));
        JScrollPane sp = new JScrollPane(top(f)); sp.setBorder(null); sp.getVerticalScrollBar().setUnitIncrement(16);
        p.add(sp, BorderLayout.CENTER);

        JPanel bw = new JPanel(new BorderLayout()); bw.setBorder(new EmptyBorder(8, 18, 12, 18)); bw.setBackground(Color.WHITE);
        bw.add(btn("등록하기", () -> {
            if (title.getText().trim().isEmpty()) { warn("상품 이름을 입력해 주세요."); return; }
            boolean rent = rb.isSelected();
            try {
                Item it = new Item(); it.rent = rent; it.title = title.getText().trim(); it.category = (String) cat.getSelectedItem();
                it.desc = desc.getText().trim(); it.owner = "나";
                if (rent) { it.deposit = num(dep.getText()); it.price = num(fee.getText()); }
                else {
