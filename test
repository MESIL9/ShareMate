    static JTextField hintField(String hint) {
        JTextField t = new JTextField() {
            @Override protected void paintComponent(Graphics g) {
                super.paintComponent(g);
                if (getText().isEmpty() && !isFocusOwner()) {
                    Graphics2D g2 = (Graphics2D) g.create(); g2.setColor(GRAY); g2.setFont(getFont()); FontMetrics fm = g2.getFontMetrics();
                    g2.drawString(hint, getInsets().left, (getHeight() + fm.getAscent() - fm.getDescent()) / 2); g2.dispose();
                }
            }
        };
        t.addFocusListener(new FocusAdapter() { public void focusGained(FocusEvent e) { t.repaint(); } public void focusLost(FocusEvent e) { t.repaint(); } });
        return t;
    }
