    JComponent thumb(Item it, int w, int h) {
        String[] ph = it.photos(); ImageIcon ic = ph.length > 0 ? icon(ph[0], w, h) : null;
        JLabel l = ic != null ? new JLabel(ic) : new JLabel(it.kind.equals(EX) ? "🍽" : "📚", SwingConstants.CENTER);
        l.setOpaque(true); l.setBackground(new Color(0xDDE3EA)); l.setFont(l.getFont().deriveFont(26f)); l.setPreferredSize(new Dimension(w, h)); return l;
    }
    ImageIcon icon(String name, int w, int h) { return cache.computeIfAbsent(name + "@" + w + "x" + h, k -> cover(st.img.resolve(name).toFile(), w, h)); }
    static ImageIcon cover(File f, int w, int h) {
        try {
            BufferedImage src = javax.imageio.ImageIO.read(f); if (src == null) return null;
            double s = Math.max((double) w / src.getWidth(), (double) h / src.getHeight());
            int nw = (int) (src.getWidth() * s), nh = (int) (src.getHeight() * s);
            BufferedImage o = new BufferedImage(w, h, BufferedImage.TYPE_INT_RGB); Graphics2D g = o.createGraphics();
            g.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BILINEAR);
            g.drawImage(src, (w - nw) / 2, (h - nh) / 2, nw, nh, null); g.dispose(); return new ImageIcon(o);
        } catch (Exception e) { return null; }
    }

