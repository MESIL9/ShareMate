    /** 1초마다 새 메시지 확인 */
    void tick() {
        if (me == null) return;
        bells.removeIf(b -> SwingUtilities.getWindowAncestor(b) == null);
        List<Msg> in = incoming(st.chats(), itemMap()); Map<String, Long> rd = st.reads(me);
        int n = 0; long maxTs = lastNotified; Msg newest = null;
        for (Msg m : in) {
            String room = m.item + "|" + m.buyer;
            if (m.ts > rd.getOrDefault(room, 0L)) n++;
            if (m.ts > lastNotified) { maxTs = Math.max(maxTs, m.ts); if (!room.equals(currentRoom) && (newest == null || m.ts > newest.ts)) newest = m; }
        }
        lastNotified = maxTs; updateBells(n);
        if (newest != null) toast("💬 " + nick(newest.sender) + ": " + (newest.text.length() > 22 ? newest.text.substring(0, 22) + "…" : newest.text));
    }

    void toast(String msg) {
        if (!isShowing()) return;
        JWindow w = new JWindow(this); JLabel l = new JLabel(msg); l.setOpaque(true); l.setBackground(new Color(0x222222)); l.setForeground(Color.WHITE);
        l.setBorder(new EmptyBorder(10, 16, 10, 16)); l.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        w.add(l); w.pack(); Point o = getLocationOnScreen(); w.setLocation(o.x + (getWidth() - w.getWidth()) / 2, o.y + 40); w.setAlwaysOnTop(true); w.setVisible(true);
        l.addMouseListener(new MouseAdapter() { public void mouseClicked(MouseEvent e) { w.dispose(); notifications(ShareMate.this::home); } });
        Timer t = new Timer(3500, e -> w.dispose()); t.setRepeats(false); t.start();
    }

    void notifications(Runnable back) {
        JPanel p = new JPanel(new BorderLayout()); p.setBackground(Color.WHITE);
        JPanel nl = col(); nl.setBorder(new EmptyBorder(6, 14, 10, 14));
        Runnable render = () -> {
            nl.removeAll(); Map<Long, Item> im = itemMap(); Map<String, Long> rd = st.reads(me);
            Map<String, Msg> last = new LinkedHashMap<>(); Map<String, Integer> cnt = new HashMap<>();
            for (Msg m : incoming(st.chats(), im)) { String key = m.item + "|" + m.buyer; last.remove(key); last.put(key, m); if (m.ts > rd.getOrDefault(key, 0L)) cnt.merge(key, 1, Integer::sum); }
            List<String> keys = new ArrayList<>(last.keySet()); Collections.reverse(keys);
            for (String key : keys) {
                Msg m = last.get(key); Item it = im.get(m.item); int u = cnt.getOrDefault(key, 0);
                JPanel row = new JPanel(new BorderLayout(10, 0)); row.setBackground(u > 0 ? SKY : Color.WHITE);
                row.setBorder(BorderFactory.createCompoundBorder(new MatteBorder(0, 0, 1, 0, LINE), new EmptyBorder(6, 6, 6, 6)));
                row.setMaximumSize(new Dimension(Integer.MAX_VALUE, 72)); row.setAlignmentX(0); row.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
                row.add(thumb(it, 52, 52), BorderLayout.WEST);
                JPanel t = new JPanel(new GridLayout(2, 1)); t.setOpaque(false);
                t.add(lbl(nick(m.sender) + " · " + it.title + (u > 0 ? "  ● 새 메시지 " + u : ""), 13, Color.BLACK, u > 0)); t.add(lbl(m.text, 12, GRAY, false)); row.add(t);
                row.add(lbl(fmt(m.ts, "M/d a h:mm"), 10, GRAY, false), BorderLayout.EAST);
                row.addMouseListener(new MouseAdapter() { public void mouseClicked(MouseEvent e) { chat(it, m.buyer, () -> notifications(back)); } });
                nl.add(row);
            }
            if (keys.isEmpty()) nl.add(lbl("<html>새 알림이 없어요.<br>채팅이 오면 여기와 종 모양에 알려드려요.</html>", 12, GRAY, false));
            nl.revalidate(); nl.repaint();
        };
        JPanel topP = col(); topP.add(header("알림", back));
        JPanel ar = new JPanel(new FlowLayout(FlowLayout.RIGHT, 10, 4)); ar.setOpaque(false); ar.setAlignmentX(0); ar.setMaximumSize(new Dimension(Integer.MAX_VALUE, 42));
        ar.add(btn("모두 읽음", () -> {
            Set<String> ks = new HashSet<>(); for (Msg m : incoming(st.chats(), itemMap())) ks.add(m.item + "|" + m.buyer);
            for (String key : ks) st.markRead(me, key);
            updateBells(0); render.run();
        }, 90, 30));
        topP.add(ar); p.add(topP, BorderLayout.NORTH);
        render.run(); p.add(scroll(nl), BorderLayout.CENTER);
        set(p, false); poll(() -> st.chats().size(), render);
    }

