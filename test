                JLabel tm = lbl(fmt(m.ts, "M/d a h:mm"), 10, GRAY, false); row.add(tm, BorderLayout.EAST);
                row.addMouseListener(new MouseAdapter() { public void mouseClicked(MouseEvent e) { chat(it, m.buyer, ShareMate.this::chatList); } });
