        }, 0, 46));
        p.add(bw, BorderLayout.SOUTH);
        set(p, false);
    }

    // ---------- 화면: 채팅 ----------
    void chat(Item it, Runnable back) {
        List<Msg> msgs = chats.computeIfAbsent(it.id, k -> new ArrayList<>());
        JPanel p = new JPanel(new BorderLayout()); p.setBackground(Color.WHITE);
        JPanel head = col(); head.add(header(it.owner, back, null));
        JPanel sum = new JPanel(new BorderLayout(10, 0)); sum.setBackground(LIGHT); sum.setBorder(new EmptyBorder(8, 12, 8, 12));
        sum.add(thumb(it, 48, 48), BorderLayout.WEST);
        JPanel si = new JPanel(new GridLayout(2, 1)); si.setOpaque(false);
        si.add(lbl(it.title, 13, Color.BLACK, true)); si.add(lbl(it.rent ? "판매 중 · " + money(it.price) : "교환 가능 · " + it.want, 12, GRAY, false));
        sum.add(si); sum.setAlignmentX(0); sum.setMaximumSize(new Dimension(Integer.MAX_VALUE, 66)); head.add(sum);
        p.add(head, BorderLayout.NORTH);

        JPanel mp = col(); mp.setBorder(new EmptyBorder(8, 10, 8, 10));
        JScrollPane sp = new JScrollPane(top(mp)); sp.setBorder(null); p.add(sp, BorderLayout.CENTER);
        Runnable render = () -> {
            mp.removeAll();
            for (Msg m : msgs) mp.add(bubbleRow(m));
            mp.revalidate(); mp.repaint();
            SwingUtilities.invokeLater(() -> { JScrollBar b = sp.getVerticalScrollBar(); b.setValue(b.getMaximum()); });
        };
        render.run();

        JTextField in = new JTextField(); in.setBorder(BorderFactory.createCompoundBorder(BorderFactory.createLineBorder(LINE), new EmptyBorder(8, 10, 8, 10)));
        Runnable send = () -> {
            String t = in.getText().trim(); if (t.isEmpty()) return;
            msgs.add(new Msg(true, t)); in.setText(""); render.run();
            Timer tm = new Timer(900, ev -> { msgs.add(new Msg(false, autoReply(t))); render.run(); });
            tm.setRepeats(false); tm.start();
        };
        in.addActionListener(e -> send.run());
        JPanel bar = new JPanel(new BorderLayout(8, 0)); bar.setBorder(new EmptyBorder(8, 10, 8, 10)); bar.setBackground(Color.WHITE);
        bar.add(in); bar.add(btn("전송", send, 64, 38), BorderLayout.EAST);
        p.add(bar, BorderLayout.SOUTH);
        set(p, false);
    }

    String autoReply(String t) {
        if (t.contains("가능")) return "네, 가능해요! 몇 시쯤 오실 수 있으세요?";
        if (t.contains("시")) return "좋아요, 그 시간에 교양관 3층 앞에서 만나요 :)";
        if (t.contains("가격") || t.contains("얼마")) return "게시글에 적힌 가격 그대로예요.";
        return "네, 확인했어요!";
    }

    JComponent bubbleRow(Msg m) {
        JPanel r = new JPanel(new FlowLayout(m.mine ? FlowLayout.RIGHT : FlowLayout.LEFT, 4, 4)); r.setOpaque(false);
        JLabel tm = lbl(m.time, 10, GRAY, false);
        JComponent b = new Bubble(m.text, m.mine);
        if (m.mine) { r.add(tm); r.add(b); } else { r.add(b); r.add(tm); }
        r.setMaximumSize(new Dimension(Integer.MAX_VALUE, r.getPreferredSize().height + 6)); r.setAlignmentX(0);
        return r;
    }

    static class Bubble extends JPanel {
        final Color c;
        Bubble(String t, boolean mine) {
            c = mine ? new Color(0xDCEBFF) : LIGHT; setOpaque(false); setLayout(new BorderLayout()); setBorder(new EmptyBorder(8, 12, 8, 12));
            JLabel l = new JLabel(); int w = Math.min(200, l.getFontMetrics(l.getFont()).stringWidth(t) + 8);
            l.setText("<html><body style='width:" + w + "px'>" + esc(t) + "</body></html>"); add(l);
        }
        @Override protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create(); g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(c); g2.fillRoundRect(0, 0, getWidth(), getHeight(), 18, 18); g2.dispose(); super.paintComponent(g);
        }
    }

    // ---------- 화면: 채팅 목록 / 마이 ----------
    void chatList() {
        JPanel c = col(); c.setBorder(new EmptyBorder(10, 14, 10, 14));
        c.add(lbl("채팅", 20, Color.BLACK, true)); c.add(Box.createVerticalStrut(10));
        if (chats.isEmpty()) c.add(lbl("아직 채팅이 없어요. 상품에서 '채팅 문의'를 눌러보세요.", 12, GRAY, false));
        List<Integer> ids = new ArrayList<>(chats.keySet()); Collections.reverse(ids);
        for (int id : ids) {
            Item it = byId(id); List<Msg> ms = chats.get(id); if (it == null) continue;
            JPanel row = new JPanel(new BorderLayout(10, 0)); row.setBackground(Color.WHITE); row.setBorder(new MatteBorder(0, 0, 1, 0, LINE));
            row.setMaximumSize(new Dimension(Integer.MAX_VALUE, 64)); row.setAlignmentX(0); row.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
            row.add(thumb(it, 52, 52), BorderLayout.WEST);
            JPanel t = new JPanel(new GridLayout(2, 1)); t.setOpaque(false);
            t.add(lbl(it.owner + " · " + it.title, 13, Color.BLACK, true));
            t.add(lbl(ms.isEmpty() ? "대화를 시작해 보세요" : ms.get(ms.size() - 1).text, 12, GRAY, false)); row.add(t);
            row.addMouseListener(new java.awt.event.MouseAdapter() { public void mouseClicked(java.awt.event.MouseEvent e) { chat(it, ShareMate.this::chatList); } });
            c.add(row);
        }
        set(wrapScroll(c), true);
    }

    void my() {
        JPanel c = col(); c.setBorder(new EmptyBorder(10, 14, 10, 14));
        c.add(lbl("마이", 20, Color.BLACK, true)); c.add(Box.createVerticalStrut(10));
        c.add(lbl("♥ 찜한 상품", 15, BLUE, true)); c.add(Box.createVerticalStrut(6));
        boolean any = false;
        for (Item it : items) if (it.fav) { c.add(card(it, () -> detail(it, this::my))); c.add(Box.createVerticalStrut(8)); any = true; }
        if (!any) c.add(lbl("찜한 상품이 없어요", 12, GRAY, false));
        c.add(Box.createVerticalStrut(14)); c.add(lbl("📦 내가 등록한 상품", 15, BLUE, true)); c.add(Box.createVerticalStrut(6));
        any = false;
        for (Item it : items) if (it.owner.equals("나")) { c.add(card(it, () -> detail(it, this::my))); c.add(Box.createVerticalStrut(8)); any = true; }
        if (!any) c.add(lbl("등록한 상품이 없어요", 12, GRAY, false));
        set(wrapScroll(c), true);
    }

