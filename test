    private void refreshProducts() {
        if (productListPanel == null) return;
        productListPanel.removeAll();
        String query = searchField.getText() == null ? "" : searchField.getText().trim().toLowerCase();
        int count = 0;
        for (Product p : products) {
            boolean categoryMatch = "전체".equals(currentCategory)
                    || ("대여".equals(currentCategory) && "대여".equals(p.type))
                    || ("물물교환".equals(currentCategory) && "물물교환".equals(p.type))
                    || currentCategory.equals(p.category);
            String searchable = (p.name + " " + p.category + " " + p.description + " " + p.type).toLowerCase();
            if (categoryMatch && searchable.contains(query)) {
                productListPanel.add(compactProduct(p));
                productListPanel.add(Box.createVerticalStrut(10));
                count++;
            }
        }
        if (count == 0) {
            JPanel empty = new JPanel();
            empty.setOpaque(false);
            empty.setBorder(new EmptyBorder(45, 5, 45, 5));
            empty.add(label("검색 결과가 없습니다.", 14, false, MUTED));
            productListPanel.add(empty);
        }
        productListPanel.revalidate();
        productListPanel.repaint();
    }

    private JPanel compactProduct(Product p) {
        JPanel card = new JPanel(new BorderLayout(12, 0));
        card.setBackground(Color.WHITE);
        card.setBorder(new CompoundBorder(new LineBorder(new Color(232, 234, 239), 1, true),
                new EmptyBorder(10, 10, 10, 10)));
        card.setMaximumSize(new Dimension(Integer.MAX_VALUE, 118));
        card.setPreferredSize(new Dimension(360, 118));
        JPanel photo = imageBox(p, 92, 92);
        card.add(photo, BorderLayout.WEST);

        JPanel info = new JPanel();
        info.setBackground(Color.WHITE);
        info.setLayout(new BoxLayout(info, BoxLayout.Y_AXIS));
        JPanel top = new JPanel(new BorderLayout());
        top.setBackground(Color.WHITE);
        top.add(label(p.name, 14, true, TEXT), BorderLayout.CENTER);
        JButton heart = new JButton(p.favorite ? "♥" : "♡");
        heart.setForeground(p.favorite ? new Color(238, 85, 112) : MUTED);
        heart.setBackground(Color.WHITE);
        heart.setBorder(null);
        heart.setFocusPainted(false);
        heart.addActionListener(e -> { p.favorite = !p.favorite; saveData(); heart.setText(p.favorite ? "♥" : "♡"); heart.setForeground(p.favorite ? new Color(238,85,112) : MUTED); });
        top.add(heart, BorderLayout.EAST);
        info.add(top);
        info.add(Box.createVerticalStrut(5));
        info.add(label(p.type + "  ·  " + p.category, 11, false, MUTED));
        info.add(Box.createVerticalStrut(7));
        info.add(label(p.type.equals("대여") ? money(p.price) + " / 보증금 " + money(p.deposit) : "교환 희망 물품 협의", 12, true, BLUE));
        info.add(Box.createVerticalStrut(5));
        info.add(label("상품 상태: " + p.condition, 11, false, MUTED));
        card.add(info, BorderLayout.CENTER);
        card.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        MouseAdapter openProduct = new MouseAdapter() {
            public void mouseClicked(MouseEvent e) { selectedProduct = p; openDetailDialog(p); }
        };
        card.addMouseListener(openProduct);
        info.addMouseListener(openProduct);
        photo.addMouseListener(openProduct);
        return card;
    }

    private JPanel imageBox(Product p, int w, int h) {
        JPanel box = new JPanel(new BorderLayout());
        box.setPreferredSize(new Dimension(w, h));
        box.setBackground(new Color(238, 241, 247));
        box.setBorder(new LineBorder(new Color(230, 232, 237), 1, true));
        if (p.imagePath != null && !p.imagePath.isEmpty() && new File(p.imagePath).exists()) {
            ImageIcon icon = new ImageIcon(p.imagePath);
            Image scaled = icon.getImage().getScaledInstance(w, h, Image.SCALE_SMOOTH);
            box.add(new JLabel(new ImageIcon(scaled)), BorderLayout.CENTER);
        } else {
            JLabel placeholder = label("상품\n사진", 13, true, new Color(160, 167, 180));
            placeholder.setHorizontalAlignment(SwingConstants.CENTER);
            box.add(placeholder, BorderLayout.CENTER);
        }
        return box;
    }

