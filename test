    // ---------- 화면: 목록 (검색 / 카테고리 / 찜 필터) ----------
    void list(int mode, String q0) {
        JPanel p = new JPanel(new BorderLayout()); p.setBackground(Color.WHITE);
        JPanel head = col();
        head.add(header(mode == 1 ? "대여" : mode == 2 ? "물물교환" : "검색 결과", this::home, null));
        JTextField sf = new JTextField(q0);
        JPanel sb = searchBar(sf, "빌리고 싶은 물건을 검색해 보세요"); sb.setMaximumSize(new Dimension(Integer.MAX_VALUE, 44));
        head.add(sb);
        JComboBox<String> cat = new JComboBox<>(); cat.addItem("전체 카테고리"); for (String c : CATS) cat.addItem(c);
        JCheckBox favOnly = new JCheckBox("♥ 찜만 보기"); favOnly.setOpaque(false);
        JLabel count = lbl("", 12, GRAY, false);
        JPanel opt = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 4)); opt.setOpaque(false);
        opt.add(cat); opt.add(favOnly); opt.add(count); opt.setAlignmentX(0);
        opt.setMaximumSize(new Dimension(Integer.MAX_VALUE, 40));
        head.add(opt);
        p.add(head, BorderLayout.NORTH);

        JPanel lp = col();
        Runnable refresh = new Runnable() {
            public void run() {
                lp.removeAll();
                String q = sf.getText().trim().toLowerCase(); int n = 0;
                for (int i = items.size() - 1; i >= 0; i--) { // 최신순
                    Item it = items.get(i);
                    if (mode == 1 && !it.rent || mode == 2 && it.rent) continue;
                    if (cat.getSelectedIndex() > 0 && !it.category.equals(cat.getSelectedItem())) continue;
                    if (favOnly.isSelected() && !it.fav) continue;
                    String hay = (it.title + it.tags + it.desc + it.want + it.category).toLowerCase();
                    if (!q.isEmpty() && !hay.contains(q)) continue;
                    lp.add(card(it, () -> detail(it, () -> list(mode, sf.getText())))); lp.add(Box.createVerticalStrut(8)); n++;
                }
                if (n == 0) lp.add(lbl("검색 결과가 없어요", 13, GRAY, false));
                count.setText("전체 " + n); lp.revalidate(); lp.repaint();
            }
        };
        sf.addActionListener(e -> refresh.run()); cat.addActionListener(e -> refresh.run()); favOnly.addActionListener(e -> refresh.run());
        refresh.run();
        JScrollPane sp = new JScrollPane(top(lp)); sp.setBorder(null); sp.getVerticalScrollBar().setUnitIncrement(16);
        p.add(sp, BorderLayout.CENTER);

        JPanel fab = new JPanel(); fab.setBackground(Color.WHITE); fab.setBorder(new EmptyBorder(8, 0, 8, 0));
        fab.add(btn("＋ 상품 등록", () -> register(mode == 2 ? 2 : 1, () -> list(mode, sf.getText())), 140, 42));
        p.add(fab, BorderLayout.SOUTH);
        set(p, true);
    }

