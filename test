            }
            if (n == 0) c.add(lbl("<html>아직 채팅이 없어요.<br>상품 상세에서 '채팅 문의'를 눌러 대화를 시작해 보세요.</html>", 12, GRAY, false));
            c.revalidate(); c.repaint();
        };
        render.run(); set(scroll(c), true); poll(() -> st.chats().size(), render);
    }

