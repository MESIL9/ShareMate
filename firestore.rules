rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    match /items/{id} {
      /* 거래 완료(done == true) 글은 ① 작성자 ② 거래 상대방 ③ 찜한 사용자만 읽을 수 있어요 */
      allow read: if request.auth != null && (
        resource.data.done == false
        || resource.data.uid == request.auth.uid
        || resource.data.partnerUid == request.auth.uid
        || request.auth.uid in resource.data.wishers
      );
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid
        /* 다른 사람은 '내 찜(wishers)'만 추가/삭제할 수 있어요 */
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wishers'])
            && request.resource.data.wishers.hasOnly(resource.data.get('wishers', []).concat([request.auth.uid]))
            && request.resource.data.wishers.hasAll(resource.data.get('wishers', []).removeAll([request.auth.uid])))
      );
    }

    match /chats/{room} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      match /messages/{m} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(db)/documents/chats/$(room)).data.members;
        allow create: if request.auth != null && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(db)/documents/chats/$(room)).data.members;
      }
    }

    /* 신고: 문서 id는 반드시 '신고자uid_대상uid' → 한 사람이 같은 회원을 여러 번 신고해도 1건만 집계 */
    match /reports/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.targetUid;
      allow update, delete: if false;
    }

    match /reviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
    }
  }
}
